---
import Layout from "../../layouts/Layout.astro"
import { CardPlayButton } from "@/components/CardPlayButton"
import { allPlaylists, songs } from "@/lib/data"
import {MusicsTable} from "@/components/MusicsTable"

export async function getStaticPaths() {
  return allPlaylists.map((playlist) => ({
    params: { id: String(playlist.id) },
  }))
}

const { id } = Astro.params

const playlist = allPlaylists.find((playlist) => playlist.id === id)
const playListSongs = songs.filter((song) => song.albumId === playlist?.albumId)
---

<Layout title="Player">
  <div
    id="playlist-container"
    class="relative flex flex-col h-full bg-zinc-900 overflow-x-hidden bg-gradient-to-t from-50% from-zinc-900 via-zinc-900/80"
    style={`background-color: ${playlist?.color?.accent ?? "#1f2937"}`}
    transition:name=`playlist ${id} box`
  >
    <div class="md:hidden px-3 pt-3">
      <button class="text-zinc-300 text-sm" onclick="history.back()" aria-label="Volver">← Volver</button>
    </div>
    <!-- <PageHeader /> -->

    <header class="flex flex-col md:flex-row gap-5 md:gap-8 px-4 md:px-6 mt-4 md:mt-12 items-center md:items-start">
      <picture class="aspect-square w-1/2 md:w-52 md:h-52 flex-none">
        <img
          src={playlist?.cover}
          alt={`Cover of ${playlist?.title}`}
          class="object-cover w-full h-full shadow-lg"
          transition:name=`playlist ${playlist?.id} image`
        />
      </picture>

      <div class="flex flex-col justify-between w-full">
        <h2 class="hidden md:flex flex-1 items-end">Playlist</h2>
        <div>
          <h1 class="text-2xl md:text-5xl font-bold block text-white truncate">
            <span transition:name=`playlist ${playlist?.id} title`>
                {playlist?.title}
            </span>
          </h1>
        </div>

        <div class="flex-1 flex items-end">
          <div class="text-sm text-gray-300 font-normal">
            <div transition:name=`playlist ${playlist?.id} artists`>
              <span>{playlist?.artists.join(", ")}</span>
            </div>
            <p class="mt-1 text-xs md:text-sm">
              <span class="text-white">{playListSongs.length} canciones</span>,
              colección local
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="pl-4 md:pl-6 pt-3 md:pt-6">
      <CardPlayButton client:load id={id} size="large" />
    </div>

    <div class="relative z-10 px-6 pt-10"></div>

    <section class="px-3 md:p-6">
      <MusicsTable songs={playListSongs} client:load/>
    </section>
  </div>
</Layout>
